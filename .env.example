# ============================
# 基础
# ============================
APP_ENV=development
APP_NAME=Furry ZJUT
DEBUG=true
SECRET_KEY=replace-me
API_V1_PREFIX=/api/v1

# 数据库（本地开发默认 docker-compose 的 PostgreSQL）
DATABASE_URL=postgresql+psycopg://jellystation:jellystation_dev_password@localhost:5432/jellystation
# 小内存主机保守连接池
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# Redis
REDIS_URL=redis://localhost:6379/0

# ============================
# 前端与 CORS
# ============================
FRONTEND_ORIGINS=http://localhost:5173,https://www.example.com

# ============================
# 对象存储（腾讯云 COS，单桶，公开/私有靠前缀隔离）
# ============================
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
PUBLIC_ASSET_BASE_URL=
PRIVATE_URL_TTL_SECONDS=900
# 个人主页布局模块数上限
PROFILE_LAYOUT_MAX_BLOCKS=16

# ============================
# 邮件 / 短信 / 人机验证
# ============================
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
HUMAN_VERIFICATION_PROVIDER=
HUMAN_VERIFICATION_SECRET_KEY=

# ============================
# 认证
# ============================
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# 是否使用 HttpOnly Secure Cookie 承载 Refresh Token（生产建议 true）
AUTH_COOKIE_SECURE=false
# Argon2 / bcrypt
PASSWORD_HASH_SCHEME=argon2

# 验证码（OTP）：开发模式 OTP_DEV_MODE=true 时验证码直接返回在响应里
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_DEV_MODE=true

# ============================
# 上传限制
# ============================
UPLOAD_MAX_BYTES=52428800

# ============================
# 可观测性
# ============================
LOG_LEVEL=INFO
SENTRY_DSN=
