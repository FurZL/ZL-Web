# ============================
# 基础
# ============================
APP_ENV=development
APP_NAME=Furry ZJUT
DEBUG=true
SECRET_KEY=replace-me
API_V1_PREFIX=/api/v1

# 数据库（本地开发默认 docker-compose 的 PostgreSQL）
DATABASE_URL=postgresql+psycopg://jellystation:jellystation_dev_password@localhost:5432/jellystation
# 小内存主机保守连接池
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# Redis
REDIS_URL=redis://localhost:6379/0

# ============================
# 前端与 CORS
# ============================
FRONTEND_ORIGINS=http://localhost:5173,https://www.example.com

# ============================
# 对象存储（腾讯云 COS，单桶，公开/私有靠前缀隔离）
# ============================
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
PUBLIC_ASSET_BASE_URL=
PRIVATE_URL_TTL_SECONDS=900
# 个人主页布局模块数上限
PROFILE_LAYOUT_MAX_BLOCKS=16

# ============================
# 邮件 / 短信 / 人机验证
# ============================
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
# 阿里云短信
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_REGION=
SMS_API_KEY=
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
HUMAN_VERIFICATION_PROVIDER=
HUMAN_VERIFICATION_SECRET_KEY=

# ============================
# 认证
# ============================
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Refresh Token 由 HttpOnly Cookie 承载，生产环境自动 Secure；跨站场景需要时显式设 true
AUTH_COOKIE_NAME=refresh_token
# 是否使用 HttpOnly Secure Cookie 承载 Refresh Token（生产建议 true）
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Argon2 / bcrypt
PASSWORD_HASH_SCHEME=argon2

# ============================
# 第三方登录（QQ）
# ============================
# OAuth 授权开始前必须通过滑块拼图验证，后端只返回授权跳转地址，不直接回传凭据。
# QQ 互联 App ID / App Key 只从环境变量读取，不写入站点设置表。
OAUTH_FRONTEND_BASE_URL=https://www.furzl.cn
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=https://www.furzl.cn/oauth/qq

# 验证码（OTP）：开发模式 OTP_DEV_MODE=true 时验证码直接返回在响应里
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=120
OTP_DEV_MODE=true

# ============================
# 上传限制
# ============================
UPLOAD_MAX_BYTES=52428800

# ============================
# 可观测性
# ============================
LOG_LEVEL=INFO
SENTRY_DSN=

# Dev 隔离前缀：多人共用同一 COS 桶时设为自己的标识，避免文件冲突。
# 数据库存逻辑 key，Provider 层透明追加此前缀。生产环境留空。
COS_DEV_PREFIX=
# SMTP 邮件
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
